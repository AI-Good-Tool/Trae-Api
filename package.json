{
  "name": "trae-switch",
  "version": "0.8.1",
  "private": true,
  "description": "Trae / Trae CN 本地账号与用量工作台",
  "type": "module",
  "main": "desktop.cjs",
  "scripts": {
    "start": "node server/index.mjs",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "inspect": "node scripts/inspect.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build:mac": "node scripts/build-mac.mjs",
    "format:check": "prettier --check \"server/**/*.mjs\" \"ui/*.{js,css,html,svg}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.cjs\"",
    "build:windows": "node scripts/build-windows.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^44.9.3",
    "prettier": "^3.9.10"
  },
  "productName": "Trae Switch"
}
